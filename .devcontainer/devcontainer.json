{
  "name": "DRIFT",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "postCreateCommand": "pip install -e '.[relay,dev]' && echo 'bash /workspaces/Drift/.devcontainer/welcome.sh' >> ~/.bashrc",
  "postStartCommand": "python -m relay.server &",
  "forwardPorts": [8765],
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
