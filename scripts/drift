#!/usr/bin/env bash
#
# Dynamic, location-independent launcher for the drift CLI.
#
# Why this exists: the setuptools "console script" generated by
# `pip install -e .` bakes an absolute path + version into the editable finder.
# If the project version is bumped without reinstalling, or the checkout is
# moved/renamed, that finder goes stale and `drift ...` dies with a
# ModuleNotFoundError. This wrapper sidesteps all of that: it locates the repo
# root from its own on-disk location, puts it on PYTHONPATH, and runs the CLI as
# a module. It works even with no editable install at all.
#
set -euo pipefail

# Resolve this script's real path, following symlinks.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"

# Walk up to the repo root (first ancestor containing pyproject.toml).
ROOT="$DIR"
while [ "$ROOT" != "/" ] && [ ! -f "$ROOT/pyproject.toml" ]; do
  ROOT="$(dirname "$ROOT")"
done

# Pick an interpreter, most-specific first, so this works whether or not a venv
# is activated. DRIFT_PYTHON overrides everything (escape hatch).
pick_python() {
  if [ -n "${DRIFT_PYTHON:-}" ]; then echo "$DRIFT_PYTHON"; return; fi
  if [ -n "${VIRTUAL_ENV:-}" ] && [ -x "$VIRTUAL_ENV/bin/python" ]; then
    echo "$VIRTUAL_ENV/bin/python"; return
  fi
  if [ -x "$DIR/python" ]; then echo "$DIR/python"; return; fi        # script lives in a venv bin
  if [ -x "$ROOT/.venv/bin/python" ]; then echo "$ROOT/.venv/bin/python"; return; fi
  if command -v python3 >/dev/null 2>&1; then echo python3; return; fi
  echo python
}
PYTHON="$(pick_python)"

export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
exec "$PYTHON" -m drift "$@"
